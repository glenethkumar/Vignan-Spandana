# Vignan Spandana Environment Configuration Template
# Duplicate this file as .env and configure values for your deployment.

# Flask Application Secret Key (Required for sessions and CSRF)
# Generate a secure key in Python using: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# Enable Debug Mode (1 = development, 0 = production)
# In production (FLASK_DEBUG=0), the server strictly refuses to start without a valid FLASK_SECRET_KEY.
FLASK_DEBUG=1

# Local Development Server Port
PORT=5000

# System Demo Mode Flag (1 = simulated calling without real telephone charges, 0 = live Outpero telephony)
DEMO_MODE=1

# Outpero AI Telephone Calling Configuration
# Official Documentation: https://docs.outpero.com/ & https://outpero.com/
# Authentication: Outpero uses a dedicated Lead Intake Secret (passed via X-Outpero-Lead-Secret header).
# IMPORTANT: OUTPERO_LEAD_SECRET is an intake-specific authentication secret, NOT a general-purpose API key.
# OUTPERO_CAMPAIGN_SLUG is the voice campaign/agent slug configured in the Outpero dashboard.
OUTPERO_LEAD_SECRET=your-outpero-lead-intake-secret
OUTPERO_CAMPAIGN_SLUG=your-outpero-campaign-slug
OUTPERO_API_BASE_URL=https://api.outpero.com
OUTPERO_WEBHOOK_SECRET=your-outpero-post-call-webhook-secret
